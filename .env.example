# Drizzle
DATABASE_URL="postgres://root:mysecretpassword@localhost:5432/local"

# RabbitMQ (sync queue, see compose.yaml)
AMQP_URL="amqp://guest:guest@localhost:5672"

# ČBF export – politeness (ADR 0005): one request per MIN_INTERVAL + random(JITTER) ms
CBF_BASE_URL="https://www.cbf.cz/xml/"
CBF_MIN_INTERVAL_MS=2000
CBF_JITTER_MS=1000
CBF_REQUEST_TIMEOUT_MS=30000
# pause of all requests after HTTP 403/429/503
CBF_BLOCK_PAUSE_MS=900000
CBF_MAX_ATTEMPTS=6

# crawl scope
CBF_AREAS="0-14"
CBF_BOOTSTRAP_SEASONS=20
# CBF_CURRENT_SEASON_YEAR=2026
CBF_WINDOW_MAX_AGE_HOURS=12
CBF_NORMALIZE_PREFETCH=4
