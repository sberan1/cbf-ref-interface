# Copy to <deploy dir>/.env on the VPS (chmod 600). Compose reads it for ${…} substitution and passes
# it to the app containers. Use hex passwords (openssl rand -hex 24): they go into connection URLs.

POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=

# Google sign-in (ADR 0008): OAuth client of type "Web application" with the redirect URI
# https://<your domain>/login/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# admins approve the other accounts (comma-separated Google e-mails)
ADMIN_EMAILS=

# Mapy.com REST API key (developer.mapy.com): addresses and car routes for travel allowances
MAPY_API_KEY=

# Graylog (ADR 0009). Web UI login: admin / GRAYLOG_ROOT_PASSWORD.
# GRAYLOG_ROOT_PASSWORD=$(openssl rand -hex 16)   GRAYLOG_PASSWORD_SECRET=$(openssl rand -hex 48)
GRAYLOG_ROOT_PASSWORD=
GRAYLOG_PASSWORD_SECRET=
# public URL of the web UI behind the reverse proxy, with the trailing slash
GRAYLOG_EXTERNAL_URI=https://logs.example.cz/
# memory: JVM heaps and container limits (measured idle: Graylog 0.85, OpenSearch 1.0, MongoDB 0.2 GB)
OPENSEARCH_HEAP=512m
OPENSEARCH_MEM_LIMIT=1536m
GRAYLOG_HEAP=512m
GRAYLOG_MEM_LIMIT=1280m
# disk: log indices of 1 GiB, the 20 newest kept (≤ ~21 GB) and a 1 GB journal: at most ~22 GB;
# graylog-setup applies the index limits to the default index set on every deploy
GRAYLOG_INDEX_MAX_BYTES=1073741824
GRAYLOG_MAX_INDICES=20
GRAYLOG_JOURNAL_MAX_SIZE=1gb
GELF_PORT=12201
GRAYLOG_UI_PORT=9000

# image tag to run; CI sets it per deploy (the commit SHA), `latest` is the newest master build
IMAGE_TAG=latest

# host ports, bound to 127.0.0.1 only
APP_PORT=3000
RABBITMQ_UI_PORT=15672

# Docker network of the reverse proxy (Nginx Proxy Manager); the app joins it as cbf-ref-app:3000
PROXY_NETWORK=nginx_default

# ČBF export – politeness (ADR 0005): one request per MIN_INTERVAL + random(JITTER) ms
CBF_MIN_INTERVAL_MS=2000
CBF_JITTER_MS=1000
CBF_BLOCK_PAUSE_MS=900000

# crawl scope
CBF_AREAS=0-14
CBF_BOOTSTRAP_SEASONS=20

# scheduler: daily refresh at this Europe/Prague time, game window every N hours
CBF_DAILY_AT=04:30
CBF_WINDOW_EVERY_HOURS=6

LOG_LEVEL=info
